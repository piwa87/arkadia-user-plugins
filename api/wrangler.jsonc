{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rkg",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rkg-wall",
      "database_id": "a4ddd84a-d649-4c63-b3a6-603841e20af8",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "RKG_CORS": "https://delwing.github.io",
    "RKG_LIMIT_GLOSOW": "300"
  },

  "secrets": {
    "required": ["RKG_ADMIN", "RKG_LIMIT_SECRET"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
