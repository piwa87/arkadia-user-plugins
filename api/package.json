{
  "name": "rkg-wall-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy:check": "yarn test && yarn typecheck && yarn types:check && wrangler deploy --dry-run && wrangler check startup --outfile .wrangler/worker-startup.cpuprofile",
    "types:bindings": "wrangler types src/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime false",
    "types:check": "wrangler types src/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime false --check",
    "db:migrate": "wrangler d1 migrations apply rkg-wall --remote",
    "db:migrate:local": "wrangler d1 migrations apply rkg-wall --local",
    "db:init": "wrangler d1 execute rkg-wall --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.1"
  }
}
